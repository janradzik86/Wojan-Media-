<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens and project data are NOT backed up by Android cloud backup;
     WoJan uses its own end-to-end controlled sync (Google Drive appData). -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /></cloud-backup>
    <device-transfer><include domain="file" /></device-transfer>
</data-extraction-rules>
